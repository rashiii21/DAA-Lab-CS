    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="a" type="Real" array="False" size=""/>
            <declare name="b" type="Real" array="False" size=""/>
            <declare name="c" type="Real" array="False" size=""/>
            <input variable="a"/>
            <input variable="b"/>
            <input variable="c"/>
            <if expression="a &gt;= b and a &gt;= c">
                <then>
                    <output expression="&quot;Largest number is &quot; &amp; a" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Largest number is &quot; &amp; c" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
